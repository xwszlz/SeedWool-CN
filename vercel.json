{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/soon-insulation",
      "destination": "/rockwool",
      "permanent": true
    },
    {
      "source": "/soon-insulation.html",
      "destination": "/rockwool",
      "permanent": true
    },
    {
      "source": "/soon-vegetable",
      "destination": "/seedling",
      "permanent": true
    },
    {
      "source": "/soon-vegetable.html",
      "destination": "/seedling",
      "permanent": true
    },
    {
      "source": "/soon-desert",
      "destination": "/other",
      "permanent": true
    },
    {
      "source": "/soon-desert.html",
      "destination": "/other",
      "permanent": true
    },
    {
      "source": "/soon-sponge",
      "destination": "/other",
      "permanent": true
    },
    {
      "source": "/soon-sponge.html",
      "destination": "/other",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, must-revalidate"
        }
      ]
    }
  ]
}